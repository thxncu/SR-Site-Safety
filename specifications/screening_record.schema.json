{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/key"
    },
    "source_aggregation": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "structural_heading",
            "umbrella_entry",
            "broad_description",
            "individual_entry",
            "unrecorded"
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "level",
        "basis",
        "locator"
      ],
      "additionalProperties": false,
      "description": "Aggregation assigned from source wording or the assessment discussion; it is not inferred solely from the numeric identifier hierarchy."
    },
    "mapping_context": {
      "type": "object",
      "properties": {
        "assessment_stage": {
          "type": "string",
          "minLength": 1
        },
        "catalogue_version": {
          "type": "string",
          "minLength": 1
        },
        "receiving_component": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assessment_stage",
        "catalogue_version",
        "receiving_component",
        "locator"
      ],
      "additionalProperties": false,
      "description": "Receiving assessment context. A selected component does not restrict the scope of the imported source entry."
    },
    "screening": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "relevant",
            "coverage_elsewhere",
            "inapplicable",
            "non_fep"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "revision_date": {
          "type": "string",
          "minLength": 1
        },
        "authorities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Persons or bodies explicitly credited with screening in the source; empty when unrecorded."
        },
        "authority_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_locator"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "outcome",
        "reason",
        "revision_date",
        "authorities",
        "authority_locator",
        "reason_locator"
      ],
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation_id": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "assessment_record",
              "imported_inventory",
              "analytical_inference"
            ]
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "source_to_target",
              "target_to_source"
            ]
          },
          "source": {
            "$ref": "#/$defs/key"
          },
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/key"
            }
          },
          "locator": {
            "$ref": "#/$defs/source_locator"
          },
          "scope": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "specified",
                  "unrecorded"
                ]
              },
              "covered_aspects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "residual_aspects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "justification": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "covered_aspects",
              "residual_aspects",
              "justification"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "relation_id",
          "origin",
          "meaning",
          "direction",
          "source",
          "targets",
          "locator",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "adoption": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "recorded",
            "unrecorded"
          ]
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "adopted_relation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "justification": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "authority",
        "decision_date",
        "adopted_relation_ids",
        "justification"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "decision_date": {
                "type": "string",
                "format": "date"
              },
              "adopted_relation_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "justification": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "description": "Evidence that specified relations were adopted for this screening disposition. Screening authorship alone does not populate this decision."
    },
    "handling": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "$ref": "#/$defs/key"
          },
          "handled_aspects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unhandled_because": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "target",
          "handled_aspects",
          "unhandled_because"
        ],
        "additionalProperties": false
      }
    },
    "applicability_premises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "enum": [
              "waste",
              "design",
              "site",
              "other"
            ]
          },
          "specification_id": {
            "type": "string",
            "minLength": 1
          },
          "specification_version": {
            "type": "string",
            "minLength": 1
          },
          "premise": {
            "type": "string",
            "minLength": 1
          },
          "residual_disposition": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "dimension",
          "specification_id",
          "specification_version",
          "premise",
          "residual_disposition"
        ],
        "additionalProperties": false
      }
    },
    "stage_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation_id": {
            "type": "string",
            "minLength": 1
          },
          "from_stage": {
            "type": "string",
            "minLength": 1
          },
          "to_stage": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "retained",
              "superseded",
              "retired",
              "unresolved"
            ]
          },
          "successor": {
            "anyOf": [
              {
                "$ref": "#/$defs/key"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "relation_id",
          "from_stage",
          "to_stage",
          "disposition",
          "successor",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "retrieval_leads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "$ref": "#/$defs/key"
          },
          "origin": {
            "const": "analytical_retrieval"
          },
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": "number"
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "eligible_pool_size": {
            "type": "integer",
            "minimum": 0
          },
          "missing_source_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "query_fingerprint": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "candidate",
          "origin",
          "method_id",
          "rank",
          "score",
          "threshold",
          "eligible_pool_size",
          "missing_source_fields",
          "query_fingerprint"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "source",
    "source_aggregation",
    "mapping_context",
    "screening",
    "relations",
    "adoption",
    "handling",
    "applicability_premises",
    "stage_changes",
    "retrieval_leads"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:srsite-traceability:screening-record:1.0.0",
  "title": "Versioned FEP screening record",
  "description": "Proposed record interchange contract. Source aggregation and receiving assessment context are separate from observed associations, relation adoption, handling annotations and analytical search leads.",
  "$defs": {
    "key": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "assessment_stage": {
          "type": "string",
          "minLength": 1
        },
        "catalogue_version": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": [
            "string",
            "null"
          ],
          "description": "Component explicitly applicable to this endpoint; null when the source does not define one. Receiving mapping context is stored separately."
        }
      },
      "required": [
        "namespace",
        "identifier",
        "assessment_stage",
        "catalogue_version",
        "component"
      ],
      "additionalProperties": false
    },
    "source_locator": {
      "type": "object",
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "evidence_span": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_file",
        "source_sha256",
        "record_id",
        "field",
        "evidence_span"
      ],
      "additionalProperties": false
    }
  }
}
